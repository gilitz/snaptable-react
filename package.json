{
  "name": "snaptable-react",
  "version": "3.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "mobx": ">=6.0.0",
    "mobx-react": ">=9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^4.0.3",
    "mobx": "^6.13.1",
    "mobx-react": "^9.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "A truly headless React table library providing only hooks and logic for building custom tables. Features column resizing, drag & drop, and layout persistence with zero styling opinions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilitz/snaptable-react.git"
  },
  "keywords": [
    "react",
    "headless",
    "headless-ui",
    "react-table",
    "table",
    "hooks",
    "drag-drop",
    "resizable",
    "columns",
    "mobx",
    "typescript",
    "unstyled",
    "customizable"
  ],
  "author": "gilitz",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gilitz/snaptable-react/issues"
  },
  "homepage": "https://github.com/gilitz/snaptable-react#readme"
}
